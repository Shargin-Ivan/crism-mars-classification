/*                                cccnnnnnnnn_xx_ooaaas_MTRv              */
/*                                ccc = Class Type                        */
/*                                nnnnnnnn = Observation ID, hexadecimal  */
/*                                xx = counter this observation (hex)     */
/*                                ooaaa = Image type, Macro number        */
/*                                s = Sensor ID (J for Joined)            */
/*                                v = Version number                      */

INSTRUMENT_HOST_NAME          = "MARS RECONNAISSANCE ORBITER"
SPACECRAFT_ID                 = MRO
